{
  "id": "ccgm/secrets",
  "name": "Secrets & Credentials",
  "version": "1.0.0",
  "applies_when": ["always"],
  "tags": ["secrets", "credentials", "security"],
  "severity_floor": "medium",
  "tools": ["gitleaks"],
  "checks": [
    {
      "id": "secrets/hardcoded-api-key",
      "severity": "critical",
      "confidence": "high",
      "detection": "tool",
      "tool": "gitleaks",
      "auto_fixable": false
    },
    {
      "id": "secrets/env-file-committed",
      "severity": "high",
      "confidence": "high",
      "detection": "llm",
      "fallback": "grep",
      "auto_fixable": false
    }
  ]
}
