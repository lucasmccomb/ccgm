{
  "id": "ccgm/secrets",
  "name": "Secrets & Credentials",
  "version": "1.0.0",
  "applies_when": ["always"],
  "tags": ["secrets", "credentials", "security"],
  "severity_floor": "high",
  "tools": ["gitleaks"],
  "checks": [
    {
      "id": "secrets/leaked-credential",
      "severity": "critical",
      "confidence": "high",
      "detection": "tool",
      "tool": "gitleaks",
      "auto_fixable": false
    },
    {
      "id": "secrets/tracked-env-file",
      "severity": "high",
      "confidence": "high",
      "detection": "hybrid",
      "tool": "grep",
      "fallback": "llm",
      "auto_fixable": false
    },
    {
      "id": "secrets/tracked-key-material",
      "severity": "critical",
      "confidence": "high",
      "detection": "hybrid",
      "tool": "grep",
      "fallback": "llm",
      "auto_fixable": false
    },
    {
      "id": "secrets/history-only-credential",
      "severity": "high",
      "confidence": "high",
      "detection": "tool",
      "tool": "gitleaks",
      "auto_fixable": false
    }
  ]
}
