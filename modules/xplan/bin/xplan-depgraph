#!/usr/bin/env python3
"""xplan-depgraph: print and check an xplan plan's epic dependency graph.

Usage:
  xplan-depgraph PLAN.md [--check] [--status E1=done,E2=run,...]

Epics are `### Epic N: Title` blocks. Each has a `**Wave:**` (or `**Wave**:`)
bullet and a `**Dependencies:**` bullet. Output is one line per wave:

  Wave 2  E3 Metrics ← E1,E2 · E5 Plan surfaces ← E2

Dependency refs come from the Dependencies bullet only, after removing
parenthetical notes and cutting at the first " — " or ";". Accepted forms:
"None", "Epic N", "Epics N–M" or "N-M", "Epics N, M and K", "Epic N/M".
A comma segment that starts "parallel-safe with" is not a dependency.
`**Dependencies note:**` bullets are ignored.

--check exits 1 and names each unknown ref, cycle, missing wave, and
dependency on the same or a later wave. A plan with no epics prints
"no epics; skipped" and exits 0.

--status marks epics: done, run, blocked, or todo (default for unlisted).
An epic id in --status that the plan does not have is an error (exit 2).

Stdlib only.
"""

from __future__ import annotations

import argparse
import re
import sys
from dataclasses import dataclass, field

STATES = ("todo", "run", "done", "blocked")

HEADING = re.compile(r"^###\s+Epic\s+(\d+)\s*[:.\-–—]?\s*(.*?)\s*$")
ANY_HEADING = re.compile(r"^#{1,3}\s")
WAVE = re.compile(r"^\s*[-*]\s+\*\*Wave(?::\*\*|\*\*:)\s*(.*)")
DEPS = re.compile(r"^\s*[-*]\s+\*\*Dependencies(?::\*\*|\*\*:)\s*(.*)")
REF = re.compile(r"(\d+)\s*[–-]\s*(\d+)|(\d+)")
DEPS_CUT = re.compile(r"\s—\s|;")
INTEGER = re.compile(r"\d+")
STATUS_PAIR = re.compile(r"E(\d+)=(\w+)")


@dataclass
class Epic:
    num: int
    title: str
    wave: int | None = None
    deps: list[int] = field(default_factory=list)


def strip_parens(s: str) -> str:
    out, depth = [], 0
    for ch in s:
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth = max(0, depth - 1)
        elif depth == 0:
            out.append(ch)
    return "".join(out)


def parse_deps(text: str) -> list[int]:
    text = strip_parens(text)
    text = DEPS_CUT.split(text, maxsplit=1)[0]
    refs: list[int] = []
    for seg in text.split(","):
        seg = seg.strip()
        if not seg or seg.lower().startswith("parallel-safe with"):
            continue
        for m in REF.finditer(seg):
            if m.group(3):
                refs.append(int(m.group(3)))
            else:
                lo, hi = int(m.group(1)), int(m.group(2))
                refs.extend(range(lo, hi + 1))
    return sorted(set(refs))


def parse(text: str) -> list[Epic]:
    epics: list[Epic] = []
    cur: Epic | None = None
    seen_deps = False
    for line in text.splitlines():
        m = HEADING.match(line)
        if m:
            cur = Epic(int(m.group(1)), m.group(2))
            seen_deps = False
            epics.append(cur)
            continue
        if ANY_HEADING.match(line):
            cur = None
            continue
        if cur is None:
            continue
        w = WAVE.match(line)
        if w and cur.wave is None:
            n = INTEGER.search(w.group(1))
            if n:
                cur.wave = int(n.group())
            continue
        d = DEPS.match(line)
        if d and not seen_deps:
            seen_deps = True
            cur.deps = parse_deps(d.group(1))
    return epics


def find_cycles(epics: list[Epic]) -> list[list[int]]:
    known = {e.num: e for e in epics}
    cycles: list[list[int]] = []
    state: dict[int, int] = {}  # 1 visiting, 2 done

    def visit(n: int, path: list[int]) -> None:
        state[n] = 1
        path.append(n)
        for d in known[n].deps:
            if d not in known:
                continue
            if state.get(d) == 1:
                cycles.append(path[path.index(d):] + [d])
            elif d not in state:
                visit(d, path)
        path.pop()
        state[n] = 2

    for e in epics:
        if e.num not in state:
            visit(e.num, [])
    return cycles


def check(epics: list[Epic]) -> list[str]:
    known = {e.num: e for e in epics}
    errors: list[str] = []
    for e in epics:
        if e.wave is None:
            errors.append(f"E{e.num}: no Wave")
        for d in e.deps:
            if d not in known:
                errors.append(f"E{e.num}: unknown dependency Epic {d}")
                continue
            dw = known[d].wave
            if e.wave is None or dw is None:
                continue
            if dw == e.wave:
                errors.append(
                    f"E{e.num} (wave {e.wave}) depends on E{d} (wave {dw}): same wave")
            elif dw > e.wave:
                errors.append(
                    f"E{e.num} (wave {e.wave}) depends on E{d} (wave {dw}): later wave")
    for cyc in find_cycles(epics):
        errors.append("cycle: " + " -> ".join(f"E{n}" for n in cyc))
    return errors


def parse_status(arg: str, epics: list[Epic]) -> dict[int, str]:
    known = {e.num for e in epics}
    out: dict[int, str] = {}
    for pair in filter(None, (p.strip() for p in arg.split(","))):
        m = STATUS_PAIR.fullmatch(pair)
        if not m:
            raise ValueError(f"bad --status pair {pair!r}; expected E<N>=<state>")
        n, st = int(m.group(1)), m.group(2)
        if n not in known:
            raise ValueError(f"--status names E{n}, which is not in the plan")
        if st not in STATES:
            raise ValueError(
                f"--status E{n}={st}: state must be one of {', '.join(STATES)}")
        out[n] = st
    return out


def render(epics: list[Epic], status: dict[int, str] | None) -> str:
    waves: dict[str, list[Epic]] = {}
    for e in sorted(epics, key=lambda e: (e.wave is None, e.wave or 0, e.num)):
        waves.setdefault("?" if e.wave is None else str(e.wave), []).append(e)
    lines = []
    for w, group in waves.items():
        items = []
        for e in group:
            s = f"E{e.num} {e.title}".rstrip()
            if status is not None:
                s += f" [{status.get(e.num, 'todo')}]"
            if e.deps:
                s += " ← " + ",".join(f"E{d}" for d in e.deps)
            items.append(s)
        lines.append(f"Wave {w}  " + " · ".join(items))
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Print and check an xplan epic graph.")
    ap.add_argument("plan")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--status", help="E1=done,E2=run,E3=blocked (others todo)")
    args = ap.parse_args(argv)

    try:
        text = open(args.plan, encoding="utf-8").read()
    except OSError as e:
        print(f"xplan-depgraph: {e}", file=sys.stderr)
        return 2

    epics = parse(text)
    if not epics:
        print("no epics; skipped")
        return 0

    status = None
    if args.status is not None:
        try:
            status = parse_status(args.status, epics)
        except ValueError as e:
            print(f"xplan-depgraph: {e}", file=sys.stderr)
            return 2

    print(render(epics, status))
    if args.check:
        errors = check(epics)
        for err in errors:
            print(f"xplan-depgraph: {err}", file=sys.stderr)
        if errors:
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
