__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# autoheal: never commit user-specific config, per-repo overrides, or API keys
modules/autoheal/config.json
**/.autoheal/config.json
**/autoheal/.env

# multi-clone workspaces: per-clone identity + dev-server ports (local-only)
.env.clone

# local audit artifacts (e.g. /audit output) — must never be published
docs/audits/

# private cross-provider review requests, snapshots, and native session metadata
.context/cross-agent-review/
